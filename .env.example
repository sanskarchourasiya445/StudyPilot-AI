# -----------------------------------------------------------------------------
# StudyPilot AI Production & Local Configuration
# -----------------------------------------------------------------------------

# Application Server
PROJECT_NAME="StudyPilot AI"
VERSION="1.0.0"
API_V1_STR="/api"
DEBUG=false
HOST="0.0.0.0"
PORT=10000

# Database Configuration (Neon Managed PostgreSQL)
# Example Neon Pooled Connection String:
DATABASE_URL="postgresql://<user>:<password>@<ep-pooler-xyz>.neon.tech/<dbname>?sslmode=require"

# Security & Authentication (JWT_SECRET or SECRET_KEY)
JWT_SECRET="REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Engine / Google Gemini API Key (Required for chat, notes, summary, quiz)
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.5-flash"

# CORS Allowed Origins (Comma-separated list or JSON array)
# Note: Not required in production when the React SPA is served same-origin by FastAPI.
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Persistence Storage Paths (For Render Persistent Disk Mount)
# When a Render Persistent Disk is attached, mount it to /data
CHROMA_PERSIST_DIRECTORY="/data/chroma_db"
UPLOAD_DIR="/data/uploads"
MAX_UPLOAD_SIZE_MB=50
FRONTEND_DIST_DIR="frontend/dist"