# -----------------------------------------------------------------------------
# StudyPilot Backend Configuration
# -----------------------------------------------------------------------------

# Environment
PROJECT_NAME="StudyPilot API"
VERSION="1.0.0"
API_V1_STR="/api"
DEBUG=true

# Database (PostgreSQL URL by default; SQLite supported for local dev/testing)
# PostgreSQL example: postgresql://postgres:postgres@localhost:5432/studypilot
DATABASE_URL="sqlite:///./studypilot.db"

# Security & Authentication
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Engine / Gemini API
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"